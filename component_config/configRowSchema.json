{
  "type": "object",
  "title": "Endpoint Configuration",
  "required": ["entity"],
  "properties": {
    "entity": {
      "type": "string",
      "title": "Entity",
      "enum": ["companies", "contacts", "employees", "products", "departments", "branchOffices", "resources", "warehouses", "vatCodes"],
      "enumNames": ["Companies", "Contacts", "Employees", "Products", "Departments", "Branch Offices", "Resources", "Warehouses", "VAT Codes"],
      "propertyOrder": 1
    },
    "table_name": {
      "type": "string",
      "title": "Output Table Name",
      "options": {
        "tooltip": "Custom name for the output table. Defaults to the entity name if left empty."
      },
      "propertyOrder": 2
    },
    "load_type": {
      "type": "string",
      "title": "Load Type",
      "enum": ["incremental_load", "full_load"],
      "enumNames": ["Incremental Load", "Full Load"],
      "default": "incremental_load",
      "options": {
        "tooltip": "Incremental Load fetches only new or modified records since the last run. Full Load extracts all records every time."
      },
      "propertyOrder": 3
    },
    "batch_size": {
      "type": "integer",
      "title": "Batch Size",
      "default": 1000,
      "minimum": 1,
      "maximum": 10000,
      "options": {
        "tooltip": "Number of records fetched per API request. Lower values reduce memory usage; higher values improve throughput. Range: 1–10 000."
      },
      "propertyOrder": 4
    },
    "requests_per_minute": {
      "type": "integer",
      "title": "Requests Per Minute",
      "default": 30,
      "minimum": 1,
      "maximum": 600,
      "options": {
        "tooltip": "Maximum number of API requests per minute. Lower this value if the Helios server returns rate-limit errors. Range: 1–600."
      },
      "propertyOrder": 5
    },
    "debug": {
      "type": "boolean",
      "title": "Debug Mode",
      "format": "checkbox",
      "default": false,
      "options": {
        "tooltip": "Enable verbose logging. Useful for troubleshooting — avoid in production as it may log sensitive data."
      },
      "propertyOrder": 6
    }
  }
}
