{
  "type": "object",
  "title": "Helios Nephrite Extractor Configuration",
  "required": ["acknowledge", "connection"],
  "properties": {
    "acknowledge": {
      "type": "boolean",
      "title": "I understand I need to contact support to set up this component",
      "format": "checkbox",
      "description": "Due to implementation limitations, we currently need to help each new client set up the integration to their Helios instance. This needs to be done only ONCE",
      "default": false,
      "propertyOrder": 0
    },
    "connection": {
      "type": "object",
      "title": "Connection",
      "required": ["server_url", "#password", "user_name", "db_profile"],
      "properties": {
        "server_url": {
          "type": "string",
          "title": "Server URL",
          "description": "Helios Nephrite application server URL (e.g., https://your-server.heliosnephrite.cz)",
          "propertyOrder": 1
        },
        "user_name": {
          "type": "string",
          "title": "User Name",
          "description": "Login username (format: DOMAIN\\firstname.lastname for Windows auth)",
          "propertyOrder": 2
        },
        "#password": {
          "type": "string",
          "title": "Password",
          "format": "password",
          "description": "Login password",
          "propertyOrder": 3
        },
        "db_profile": {
          "type": "string",
          "title": "Database Profile",
          "description": "Database profile name",
          "propertyOrder": 4
        },
        "language_id": {
          "type": "string",
          "title": "Language",
          "default": "en",
          "enum": ["cs", "en", "de", "sk"],
          "enumNames": ["Czech", "English", "German", "Slovak"],
          "propertyOrder": 6
        }
      },
      "propertyOrder": 1
    }
  }
}
